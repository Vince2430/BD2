# ============================================================
# Modèle de configuration — À COPIER EN « .env »
#
#     cp .env.example .env
#
# Le fichier .env contient le mot de passe : il N'EST PAS remis
# et il est ignoré par git (voir .gitignore).
# Ce fichier-ci (.env.example) ne doit JAMAIS contenir de vrai
# mot de passe.
#
# Les applications Python et C# lisent toutes les deux ces mêmes
# variables : le .env peut donc rester ici, à côté des deux projets.
# ============================================================

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=remplace_moi

# Base de la partie 1 (modèle relationnel)
PGDATABASE_SQL=atelier_bibliotheque_sql

# Base de la partie 2 (modèle documentaire JSONB)
PGDATABASE_JSONB=atelier1_bibliotheque_jsonb
